# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Use the SAME project as the mobile app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Multi-Cloud Media Infrastructure ----
# 1. Cloudflare Worker Relay (handles server-side Bunny uploads, push notifications, URL verification):
# Address of your deployed worker (e.g. https://top-relay.yoursubdomain.workers.dev)
VITE_WORKER_URL=
VITE_PUSH_URL=

# 2. Cloudinary (images, thumbnails, banners):
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Note on Bunny Storage:
# Bunny Storage credentials (BUNNY_STORAGE_ACCESS_KEY, BUNNY_STORAGE_ZONE_NAME) are stored
# STRICTLY on the server (in the Cloudflare Worker via wrangler secrets).
# Never place Bunny API keys or access keys in this client .env file!

# Optional: public website address (e.g. https://your-site.onrender.com) so the Comments page can link to each testimony.
VITE_SITE_URL=
