rules_version = '2';

// Data model shared by the mobile app and the admin portal.
// Admins are users that have a document at admins/{their uid} (create it by hand in the Firebase console).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Content interest tags (testimonies, written, articles, lyrical analyses, LoveWorld videos): optional,
    // at most 5, only from the fixed list. Same list as worker/src/tags.js (tests/contentTags.test.mjs).
    function validContentTags() {
      let d = request.resource.data;
      return !('tags' in d)
        || (d.tags is list && d.tags.size() <= 5
          && d.tags.hasOnly(['healing', 'salvation', 'deliverance', 'miracles', 'finances', 'family', 'marriage', 'youth', 'faith', 'hope', 'worship', 'missions']));
    }

    // A user may check whether THEY are an admin. Nobody can write here from a client.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Server-controlled records (from the backend rules). Only the Admin SDK on the server reads or writes
    // these; clients are denied. Trusted devices and OTP state are also kept in the Worker today.
    match /emailVerifications/{uid} {
      allow read, write: if false;
    }
    match /deviceTrust/{id} {
      allow read, write: if false;
    }

    // Profile metadata: the owner and admins read it; only admins write it.
    match /userProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Testimonies: the app only sees published ones; admins see and manage everything.
    match /testimonies/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.isPublished == true || resource.data.published == true));
      allow create, update: if isAdmin() && validContentTags();
      allow delete: if isAdmin();
    }

    // Onboarding media shown on the Welcome screen BEFORE sign-in (public, non-sensitive):
    // { mediaType: 'image'|'video', mediaUrl, posterUrl, overlayOpacity }
    match /settings/onboarding {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live stream settings (a single document).
    match /settings/live {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =====================================================================
    // 1. ADOTOPOC RESOURCE CENTER
    // =====================================================================
    match /settings/adotopoc {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adotopocResources/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.published == true || resource.data.status == 'published'));
      allow write: if isAdmin();
    }

    // =====================================================================
    // 2. PROMOTIONALS SECTION
    // =====================================================================
    match /promotions/{id} {
      // Allow anyone to read published promos; admins manage everything
      allow read: if isAdmin() || resource.data.isPublished == true || resource.data.published == true || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    // =====================================================================
    // 3. WRITE-UPS & ARTICLES
    // =====================================================================
    match /articles/{id} {
      // Allow anyone to read published articles; admins manage everything
      allow read: if isAdmin() || resource.data.isPublished == true || resource.data.published == true || resource.data.status == 'published';
      allow create, update: if isAdmin() && validContentTags();
      allow delete: if isAdmin();
    }

    // In-app notification feed + announcement triggers.
    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.published == true || resource.data.status == 'published' || resource.data.isPublished == true));
      allow write: if isAdmin();
    }

    // =====================================================================
    // USER PROFILES: users/{uid}, one document per account (keyed by the Firebase UID).
    // The owner can create it once and complete a pending profile once; nobody can change another
    // user's profile, delete it, or write any other field. Admins can read for support.
    // =====================================================================
    function profileTitleOk(t) {
      return t in ['Mr', 'Mrs', 'Ms', 'Bro', 'Sis', 'Deacon', 'Deaconess', 'Pastor', 'Evangelist'];
    }
    function validProfileValues(d) {
      return profileTitleOk(d.title)
        && d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 120
        && d.zone is string && d.zone.size() > 0 && d.zone.size() <= 120
        && d.church is string && d.church.size() > 0 && d.church.size() <= 160;
    }
    // Video moment clips: written only by the scheduled indexer (admin SDK, which bypasses rules).
    // The app can read clips of published testimonies, and cannot write any.
    match /testimonyClips/{clipId} {
      allow read: if isAdmin() || (signedIn() && resource.data.isPublished == true);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // Either waiting for the profile form (e.g. first Google sign-in), or saved complete at sign-up.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['profileStatus', 'createdAt', 'title', 'fullName', 'zone', 'church', 'profileCompletedAt', 'updatedAt'])
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.profileStatus == 'pending' && !('title' in request.resource.data))
          || (request.resource.data.profileStatus == 'complete'
              && validProfileValues(request.resource.data)
              && request.resource.data.profileCompletedAt == request.time));

      // The welcome tour status, saved on the account so it follows the user to other devices.
      // Only tourStatus/tourUpdatedAt may change, and only to 'completed' or 'skipped'.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tourStatus', 'tourUpdatedAt'])
        && request.resource.data.tourStatus in ['completed', 'skipped']
        && request.resource.data.tourUpdatedAt == request.time;

      // Completing a pending profile, once, with validated values.
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.profileStatus == 'pending'
        && request.resource.data.profileStatus == 'complete'
        && request.resource.data.keys().hasOnly(['profileStatus', 'createdAt', 'title', 'fullName', 'zone', 'church', 'profileCompletedAt', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.profileCompletedAt == request.time
        && validProfileValues(request.resource.data);

      allow delete: if false;
    }

    // Per-user notification state (e.g., read/unread tracking).
    match /users/{uid}/notifications/{id} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, delete: if isAdmin();
      allow update: if signedIn() 
        && request.auth.uid == uid 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
    }

    // =====================================================================
    // Assistant chats saved to the account. Private to the owner; one document per chat.
    match /users/{uid}/assistantChats/{chatId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['title', 'turnsJson', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.turnsJson is string && request.resource.data.turnsJson.size() <= 200000
        && request.resource.data.updatedAt is number;
    }

    // =====================================================================
    // 4. TOP RADIO & AUDIO TESTIMONIES
    // =====================================================================
    // TOP Radio stream configuration (stream URL, programme title, live status).
    match /settings/radio {
      allow read: if true;
      allow write: if isAdmin();
    }

    // LoveWorld Singers page: background video link (set from the admin portal).
    match /settings/loveworldSingers {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audio testimonies library.
    match /audioTestimonies/{id} {
      // Allow anyone to listen to published audio
      allow read: if isAdmin() || resource.data.isPublished == true || resource.data.published == true || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    // TOP Radio listener presence (matches existing liveViewers subcollection pattern).
    match /radioListeners/{sessionId} {
      allow read, delete: if isAdmin();
    }
    match /radioListeners/{sessionId}/listeners/{uid} {
      allow read: if isAdmin();
      allow write, delete: if signedIn() && request.auth.uid == uid;
    }

    // Direct radio session heartbeats & analytics.
    match /radioSessions/{sessionId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastHeartbeat', 'status', 'endTime']);
    }

    // =====================================================================
    // EXISTING APP COLLECTIONS
    // =====================================================================
    // Testimonies shared from the app. Users can create their own; only admins can read/manage them.
    match /testimonySubmissions/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fullName','churchZone','testimony','userId','userEmail','source','status','createdAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() < 200
        && request.resource.data.churchZone is string && request.resource.data.churchZone.size() < 200
        && request.resource.data.testimony is string && request.resource.data.testimony.size() > 0 && request.resource.data.testimony.size() < 5001
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Push tokens: a user manages only their own tokens. Only the fields the app and the
    // notification engine use are accepted, with types and bounds (audit S2).
    function validPushPrefs(p) {
      return p is map && p.keys().hasOnly(['testimonies', 'live', 'announcements', 'promotions', 'choirs', 'loveworld', 'articles'])
        && (!('testimonies' in p) || p.testimonies is bool)
        && (!('live' in p) || p.live is bool)
        && (!('announcements' in p) || p.announcements is bool)
        && (!('promotions' in p) || p.promotions is bool)
        && (!('choirs' in p) || p.choirs is bool)
        && (!('loveworld' in p) || p.loveworld is bool)
        && (!('articles' in p) || p.articles is bool);
    }
    function validPushToken(d) {
      // credFailures is written by the notification engine (wrong-project builds); clients may keep it.
      return d.keys().hasOnly(['token', 'uid', 'platform', 'prefs', 'updatedAt', 'timeZone', 'utcOffsetMinutes', 'appVersion', 'credFailures'])
        && d.token is string && d.token.size() >= 10 && d.token.size() <= 200
        && d.token.matches('^Expo(nent)?PushToken\\[.+\\]$')
        && d.uid is string && d.uid == request.auth.uid
        && d.platform in ['android', 'ios']
        && validPushPrefs(d.prefs)
        && d.updatedAt == request.time
        && (!('timeZone' in d) || (d.timeZone is string && d.timeZone.size() >= 1 && d.timeZone.size() <= 64))
        && (!('utcOffsetMinutes' in d) || (d.utcOffsetMinutes is int && d.utcOffsetMinutes >= -840 && d.utcOffsetMinutes <= 840))
        && (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 30))
        && (!('credFailures' in d) || (d.credFailures is int && d.credFailures >= 0 && d.credFailures <= 10));
    }
    match /pushTokens/{token} {
      allow create, update: if signedIn() && validPushToken(request.resource.data);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow read: if isAdmin();
    }

    // Analytics: apps write; admins read AND delete (the "reset everything" tool needs this).
    // Events are validated: a short snake_case name, a bounded params map, the writer's own uid
    // (or null) and a server timestamp. Free-form documents are refused (audit S3).
    match /analyticsEvents/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['event', 'params', 'uid', 'platform', 'ts'])
        && request.resource.data.event is string
        && request.resource.data.event.matches('^[a-z][a-z0-9_]{0,47}$')
        && request.resource.data.params is map
        && request.resource.data.params.size() <= 12
        && (request.resource.data.uid == request.auth.uid || request.resource.data.uid == null)
        && (!('platform' in request.resource.data) || (request.resource.data.platform is string && request.resource.data.platform.size() <= 16))
        && request.resource.data.ts == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Live viewer presence: a heartbeat doc per person currently on the Live screen while a
    // stream is live (see src/hooks/useLiveViewer.ts in the mobile app). A user can only write
    // their own doc; admins read the whole set to show a live viewer count, and can clean it up
    // on reset.
    match /liveViewers/{sessionId} {
      allow read, delete: if isAdmin();
    }
    match /liveViewers/{sessionId}/viewers/{uid} {
      allow read: if isAdmin();
      allow write, delete: if signedIn() && request.auth.uid == uid;
    }

    // Live chat: scoped per stream session. Anyone signed in can read/post as themselves;
    // messages can't be edited once sent; only admins can delete (moderation).
    match /liveChat/{sessionId} {
      allow read, delete: if isAdmin(); // the rare "parent" doc itself, if one ever exists
    }
    match /liveChat/{sessionId}/messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() < 60
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Reports on chat messages: anyone can file one, only admins can read/manage them.
    match /liveChatReports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Bank-transfer sponsorships: a user can create and read their own; only admins can change status.
    match /sponsorships/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.receiptUrl is string && request.resource.data.receiptUrl.size() > 0;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================================
    // COMMENTS on video testimonies (testimonies/{id}/comments) and audio
    // testimonies (audioTestimonies/{id}/comments).
    //  - Document id == the commenter's Firebase UID: one comment per account
    //    per item, enforced by the database (a second device edits it).
    //  - Only signed-in users; the uid/media fields can never be changed or
    //    spoofed; text 1..1000 chars; server timestamps only.
    //  - Rate limit: every create/edit must be written in the same batch as
    //    commentRate/{uid}, which only accepts one write per 15 seconds.
    //  - Moderation: only admins change `status` (visible|hidden) or delete
    //    other people's comments. Hidden comments are visible to admins and
    //    to their author only.
    // =====================================================================
    function isPublishedDoc(path) {
      let d = get(path).data;
      return d.get('isPublished', false) == true || d.get('published', false) == true || d.get('status', '') == 'published';
    }
    function validCommentText(t) {
      return t is string && t.size() <= 1000 && t.trim().size() > 0;
    }
    function rateStamped(uid) {
      return getAfter(/databases/$(database)/documents/commentRate/$(uid)).data.lastAt == request.time;
    }
    function validNewComment(uid, mediaType, mediaId) {
      let c = request.resource.data;
      return c.keys().hasOnly(['uid', 'displayName', 'text', 'mediaType', 'mediaId', 'mediaTitle', 'status', 'createdAt', 'updatedAt'])
        && c.keys().hasAll(['uid', 'displayName', 'text', 'mediaType', 'mediaId', 'status', 'createdAt', 'updatedAt'])
        && c.uid == request.auth.uid && uid == request.auth.uid
        && c.mediaType == mediaType && c.mediaId == mediaId
        && c.displayName is string && c.displayName.size() > 0 && c.displayName.size() <= 60
        && (!('mediaTitle' in c) || (c.mediaTitle is string && c.mediaTitle.size() <= 200))
        && validCommentText(c.text)
        && c.status == 'visible'
        && c.createdAt == request.time && c.updatedAt == request.time;
    }
    function validOwnEdit(uid) {
      let c = request.resource.data;
      return resource.data.uid == request.auth.uid && uid == request.auth.uid
        && c.diff(resource.data).affectedKeys().hasOnly(['text', 'displayName', 'updatedAt'])
        && validCommentText(c.text)
        && c.displayName is string && c.displayName.size() > 0 && c.displayName.size() <= 60
        && c.updatedAt == request.time;
    }
    function validModeration() {
      let c = request.resource.data;
      return isAdmin()
        && c.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedAt', 'moderatedBy'])
        && c.status in ['visible', 'hidden']
        && c.moderatedBy == request.auth.uid && c.moderatedAt == request.time;
    }
    function canReadComment(parentPath) {
      return isAdmin() || (signedIn() && isPublishedDoc(parentPath)
        && (resource.data.status == 'visible' || resource.data.uid == request.auth.uid));
    }

    match /testimonies/{mediaId}/comments/{uid} {
      allow read: if canReadComment(/databases/$(database)/documents/testimonies/$(mediaId));
      allow create: if signedIn() && validNewComment(uid, 'video', mediaId) && rateStamped(uid)
        && isPublishedDoc(/databases/$(database)/documents/testimonies/$(mediaId));
      allow update: if (signedIn() && validOwnEdit(uid) && rateStamped(uid)) || validModeration();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /audioTestimonies/{mediaId}/comments/{uid} {
      allow read: if canReadComment(/databases/$(database)/documents/audioTestimonies/$(mediaId));
      allow create: if signedIn() && validNewComment(uid, 'audio', mediaId) && rateStamped(uid)
        && isPublishedDoc(/databases/$(database)/documents/audioTestimonies/$(mediaId));
      allow update: if (signedIn() && validOwnEdit(uid) && rateStamped(uid)) || validModeration();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // WRITTEN TESTIMONIES (text testimonies shown in the app's library). Admins write them, usually
    // from an approved testimony submission; signed-in users read the published ones.
    function validWrittenTestimony() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.body is string && d.body.size() > 0 && d.body.size() <= 20000
        && d.isPublished is bool
        && (!('authorName' in d) || (d.authorName is string && d.authorName.size() <= 120))
        && (!('churchZone' in d) || (d.churchZone is string && d.churchZone.size() <= 160))
        && (!('category' in d) || (d.category is string && d.category.size() <= 60))
        && (!('authorPhotoUrl' in d) || (d.authorPhotoUrl is string && d.authorPhotoUrl.size() <= 1000));
    }

    match /writtenTestimonies/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.isPublished == true);
      allow create, update: if isAdmin() && validWrittenTestimony() && validContentTags();
      allow delete: if isAdmin();
    }

    match /writtenTestimonies/{mediaId}/comments/{uid} {
      allow read: if canReadComment(/databases/$(database)/documents/writtenTestimonies/$(mediaId));
      allow create: if signedIn() && validNewComment(uid, 'written', mediaId) && rateStamped(uid)
        && isPublishedDoc(/databases/$(database)/documents/writtenTestimonies/$(mediaId));
      allow update: if (signedIn() && validOwnEdit(uid) && rateStamped(uid)) || validModeration();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // WORSHIP WITH YOUR LOVEWORLD SINGERS: video library. Admins manage every video; signed-in users
    // only see published ones (unpublished videos are never returned to the app or the web).
    function validSingersVideo() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.videoUrl is string && d.videoUrl.size() > 0 && d.videoUrl.size() <= 1000
        && d.isPublished is bool
        && (!('description' in d) || (d.description is string && d.description.size() <= 2000))
        && (!('thumbnailUrl' in d) || (d.thumbnailUrl is string && d.thumbnailUrl.size() <= 1000))
        && (!('duration' in d) || (d.duration is number && d.duration >= 0))
        && (!('order' in d) || d.order is number)
        && (!('isFeatured' in d) || d.isFeatured is bool)
        && (!('isDownloadable' in d) || d.isDownloadable is bool);
    }
    match /loveworldSingersVideos/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.isPublished == true);
      allow create, update: if isAdmin() && validSingersVideo() && validContentTags();
      allow delete: if isAdmin();
    }

    // FEATURED CHOIRS / GROUPS showcase. Admins add entries; signed-in users see the published ones.
    match /featuredChoirs/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.isPublished == true);
      allow create, update: if isAdmin()
        && request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 && request.resource.data.groupName.size() <= 120
        && request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() > 0 && request.resource.data.videoUrl.size() <= 1000
        && request.resource.data.isPublished is bool;
      allow delete: if isAdmin();
    }

    // "FEATURE YOUR CHOIR/GROUP ON T.O.P" requests. Anyone signed in can send one (always pending, always
    // under their own uid). Nobody can read them from the app: only admins review them. Requests are kept:
    // nobody can delete them, and admins can only change the review fields.
    function validChoirRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(['groupName', 'churchZone', 'ministrationUrl', 'songTitle', 'submittedBy', 'submittedAt', 'status'])
        && d.keys().hasAll(['groupName', 'churchZone', 'ministrationUrl', 'songTitle', 'submittedBy', 'submittedAt', 'status'])
        && d.groupName is string && d.groupName.size() > 0 && d.groupName.size() <= 120
        && d.churchZone is string && d.churchZone.size() > 0 && d.churchZone.size() <= 160
        && d.songTitle is string && d.songTitle.size() > 0 && d.songTitle.size() <= 200
        && d.ministrationUrl is string && d.ministrationUrl.size() > 0 && d.ministrationUrl.size() <= 500
        && d.ministrationUrl.matches('^https://(www[.]|m[.])?(youtube[.]com|youtu[.]be|facebook[.]com|fb[.]watch|vimeo[.]com)/.+')
        && d.submittedBy == request.auth.uid
        && d.submittedAt == request.time
        && d.status == 'pending';
    }
    match /choirFeatureRequests/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && validChoirRequest();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['pending', 'reviewed', 'approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // "FEEDBACK & SUGGESTIONS" (appFeedback). A signed-in user can send feedback under their own uid,
    // always with status 'new'. Nobody can read it from the app (not even the sender), edit it or delete
    // it. Admins read everything and may only change the status. Abuse limit: every create must be written
    // in the same batch as feedbackRate/{uid}, which accepts one write per 15 seconds.
    function validFeedback() {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId', 'feedbackType', 'subject', 'message', 'rating', 'platform', 'appVersion', 'status', 'createdAt'])
        && d.keys().hasAll(['userId', 'feedbackType', 'message', 'platform', 'appVersion', 'status', 'createdAt'])
        && d.userId == request.auth.uid
        && d.feedbackType in ['general', 'suggestion', 'problem', 'experience', 'other']
        && d.message is string && d.message.size() <= 2000 && d.message.trim().size() > 0
        && (!('subject' in d) || (d.subject is string && d.subject.size() > 0 && d.subject.size() <= 120))
        && (!('rating' in d) || (d.rating is int && d.rating >= 1 && d.rating <= 5))
        && d.platform in ['android', 'ios', 'web']
        && d.appVersion is string && d.appVersion.size() > 0 && d.appVersion.size() <= 20
        && d.status == 'new'
        && d.createdAt == request.time;
    }
    match /appFeedback/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && validFeedback()
        && getAfter(/databases/$(database)/documents/feedbackRate/$(request.auth.uid)).data.lastAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['new', 'reviewed', 'resolved']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // Per-user feedback rate limit stamp (see above). Only the user, only "now", at most every 15 s.
    match /feedbackRate/{uid} {
      allow read: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt']) && request.resource.data.lastAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt']) && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(15, 's');
      allow delete: if false;
    }

    // LYRICAL ANALYSIS: pre-produced analysis videos of LoveWorld songs, managed by admins.
    // Ordinary signed-in users only read PUBLISHED items; drafts and unpublished items stay admin-only.
    // Publishing needs a video link. Admins can change content, status and order.
    function validLyricalAnalysis() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.songTitle is string && d.songTitle.size() > 0 && d.songTitle.size() <= 200
        && (!('artistName' in d) || (d.artistName is string && d.artistName.size() <= 200))
        && (!('description' in d) || (d.description is string && d.description.size() <= 5000))
        && d.videoUrl is string && d.videoUrl.size() <= 1000
        && (!('thumbnailUrl' in d) || (d.thumbnailUrl is string && d.thumbnailUrl.size() <= 1000))
        && (!('duration' in d) || (d.duration is number && d.duration >= 0))
        && d.status in ['draft', 'published', 'unpublished']
        && (d.status != 'published' || d.videoUrl.size() > 0)
        && d.displayOrder is number;
    }
    match /lyricalAnalyses/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'published');
      allow create: if isAdmin() && validLyricalAnalysis() && validContentTags() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() && validLyricalAnalysis() && validContentTags();
      allow delete: if isAdmin();
    }

    // Admin dashboard: one collection-group query across every comments collection.
    match /{path=**}/comments/{commentId} {
      allow read: if isAdmin();
    }

    // Per-user comment rate limit stamp (see above). Only the user, only "now", at most every 15 s.
    match /commentRate/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt']) && request.resource.data.lastAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt']) && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(15, 's');
      allow delete: if false;
    }

    // =====================================================================
    // NOTIFICATION ENGINE (worker src/notify). The engine runs on the Worker with a service identity,
    // which bypasses these rules. Clients never write engine state; admins may read it, switch the
    // engine on or off, change delivery windows, and cancel a campaign. Everything else is server only.
    // =====================================================================

    // Engine config: { enabled, windows[], defaultTimezone }. "enabled" missing means on.
    match /settings/notificationEngine {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'windows', 'defaultTimezone', 'updatedAt', 'updatedBy'])
        && (!('enabled' in request.resource.data) || request.resource.data.enabled is bool)
        && (!('windows' in request.resource.data) || (request.resource.data.windows is list && request.resource.data.windows.size() <= 12))
        && (!('defaultTimezone' in request.resource.data) || (request.resource.data.defaultTimezone is string && request.resource.data.defaultTimezone.size() <= 64))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Campaigns: created by the Worker. An admin may only cancel one that has not finished.
    match /notificationCampaigns/{id} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy'])
        && resource.data.status in ['scheduled', 'fanning_out', 'queued']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledAt == request.time;
    }

    // Per-person queue items, the per-person send ledger and daily stats: engine writes, admins read
    // the queue and stats for monitoring. The ledger is server only.
    match /notificationQueue/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /notificationStats/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /notificationLedger/{uid} {
      allow read, write: if false;
    }

    // AI request logs (no content): written by the Worker, read by admins.
    match /ai_requests/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =====================================================================
    // PERSONAL DISCOVERY (T.O.P. 2.0, Phase 1). Activity is minimal and per person. It is written by the
    // app, read by the owner (for "clear my history") and deleted with the account by the server.
    // =====================================================================
    match /user_activity/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'contentType', 'contentId', 'ts', 'source'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['view', 'play', 'complete', 'save', 'open_notification']
        && request.resource.data.contentType in ['testimony', 'lyrical', 'article', 'written', 'audio', 'live']
        && request.resource.data.contentId is string && request.resource.data.contentId.size() > 0 && request.resource.data.contentId.size() <= 100
        && request.resource.data.source is string && request.resource.data.source.size() <= 20
        && request.resource.data.ts == request.time;
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // =====================================================================
    // COMMUNITY AND EDITORIAL (T.O.P. 2.0, Phase 4)
    // =====================================================================

    // Editorial configuration: the curated lines, radio schedule and featured picks for the Home "Daily
    // discovery" section. Signed-in people read it; only admins write it. It holds no personal data.
    function validEditorial(d) {
      return d.keys().hasOnly(['inspirations', 'radioSchedule', 'featuredIds', 'highlightChoirIds', 'updatedAt'])
        && (!('inspirations' in d) || (d.inspirations is list && d.inspirations.size() <= 30))
        && (!('radioSchedule' in d) || (d.radioSchedule is list && d.radioSchedule.size() <= 7))
        && (!('featuredIds' in d) || (d.featuredIds is map && d.featuredIds.keys().hasOnly(['testimony', 'lyrical', 'article'])))
        && (!('highlightChoirIds' in d) || (d.highlightChoirIds is list && d.highlightChoirIds.size() <= 6))
        && d.updatedAt == request.time;
    }
    match /settings/editorial {
      allow read: if signedIn() || isAdmin();
      allow write: if isAdmin() && validEditorial(request.resource.data);
    }

    // Reports on community content (a choir, a lyrical analysis, a testimony, an article, a comment).
    // One report per person per item: the id is "<uid>_<type>_<id>", so a second report cannot be created.
    // Reporters can see their own; only admins review, and only the review fields can change.
    function validReport() {
      let d = request.resource.data;
      return d.keys().hasOnly(['reporterUid', 'contentType', 'contentId', 'reason', 'note', 'status', 'createdAt'])
        && d.reporterUid == request.auth.uid
        && d.contentType in ['testimony', 'lyrical', 'article', 'choir', 'comment', 'written']
        && d.contentId is string && d.contentId.matches('^[A-Za-z0-9_-]{1,100}$')
        && d.reason in ['inappropriate', 'misleading', 'hateful', 'spam', 'other']
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && d.status == 'open'
        && d.createdAt == request.time;
    }
    match /contentReports/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if signedIn() && validReport()
        && id == request.resource.data.reporterUid + '_' + request.resource.data.contentType + '_' + request.resource.data.contentId;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['open', 'reviewed', 'actioned', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // =====================================================================
    // MY T.O.P. (Phase 2): saved items, collections and listening history. Private to the owner, and
    // deleted with the account. Document ids are canonical: "<contentType>_<contentId>".
    // =====================================================================
    function validLibraryKey(d) {
      return d.contentType in ['testimony', 'lyrical']
        && d.contentId is string && d.contentId.matches('^[A-Za-z0-9_-]{1,100}$');
    }
    match /users/{uid}/saved/{id} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['contentType', 'contentId', 'title', 'subtitle', 'thumbnail', 'savedAt'])
        && validLibraryKey(request.resource.data)
        && id == request.resource.data.contentType + '_' + request.resource.data.contentId
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && (!('subtitle' in request.resource.data) || (request.resource.data.subtitle is string && request.resource.data.subtitle.size() <= 200))
        && (!('thumbnail' in request.resource.data) || (request.resource.data.thumbnail is string && request.resource.data.thumbnail.size() <= 1000))
        && request.resource.data.savedAt == request.time;
      allow update: if false;
    }

    match /users/{uid}/collections/{cid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'itemIds', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && request.resource.data.itemIds is list && request.resource.data.itemIds.size() <= 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'itemIds', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && request.resource.data.itemIds is list && request.resource.data.itemIds.size() <= 200
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    // One document per item. positionSec is where the person stopped, and completed marks a finished item.
    match /users/{uid}/history/{hid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['contentType', 'contentId', 'title', 'thumbnail', 'positionSec', 'durationSec', 'completed', 'updatedAt'])
        && validLibraryKey(request.resource.data)
        && hid == request.resource.data.contentType + '_' + request.resource.data.contentId
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && (!('thumbnail' in request.resource.data) || (request.resource.data.thumbnail is string && request.resource.data.thumbnail.size() <= 1000))
        && request.resource.data.positionSec is number && request.resource.data.positionSec >= 0 && request.resource.data.positionSec <= 86400
        && request.resource.data.durationSec is number && request.resource.data.durationSec >= 0 && request.resource.data.durationSec <= 86400
        && request.resource.data.completed is bool
        && request.resource.data.updatedAt == request.time;
    }

    // The owner's interests and discovery settings. Interests are allowlisted tags, never free text.
    match /users/{uid}/private/discovery {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['interests', 'optOut', 'updatedAt'])
        && request.resource.data.interests is list && request.resource.data.interests.size() <= 20
        && request.resource.data.optOut is bool
        && request.resource.data.updatedAt == request.time;
    }

  }
}
