# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app: never put secrets here.

# 'firestore' (default) or 'rest'
EXPO_PUBLIC_BACKEND_MODE=firestore

# Firebase web config (Firebase console > Project settings > Your apps > Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firestore collection / document names: change to match the EXISTING website backend
EXPO_PUBLIC_COL_TESTIMONIES=testimonies
EXPO_PUBLIC_COL_NOTIFICATIONS=notifications
EXPO_PUBLIC_COL_SUBMISSIONS=testimonySubmissions
EXPO_PUBLIC_COL_PUSH_TOKENS=pushTokens
EXPO_PUBLIC_COL_ANALYTICS=analyticsEvents
EXPO_PUBLIC_DOC_LIVE=settings/live

# REST mode only (existing Node/Express API)
EXPO_PUBLIC_API_BASE_URL=https://testimoniesofpraiseweb.onrender.com

# Google OAuth client IDs (Google Cloud console > Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Public website used in share messages
EXPO_PUBLIC_WEBSITE_URL=https://testimoniesofpraiseweb.onrender.com

# Read by app.config.ts at build time
EAS_PROJECT_ID=
IOS_BUNDLE_ID=com.testimoniesofpraise.app
ANDROID_PACKAGE=com.testimoniesofpraise.app
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist

# Optional: 'off' stops the app writing analytics events (saves free-plan Firestore writes)
EXPO_PUBLIC_ANALYTICS=on

# Multi-Cloud Media Infrastructure:
# 1. Bunny Storage: audio and large files (secrets stay server-side on the worker!)
# Optional custom CDN pull zone hostname (e.g. media.testimoniesofpraise.org or top-media.b-cdn.net)
EXPO_PUBLIC_BUNNY_CDN_HOSTNAME=

# 2. Cloudinary: images, thumbnails, receipts, banners
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Bank transfer details shown on the Sponsor screen — replace with the real Parallex account
EXPO_PUBLIC_BANK_NAME=Parallex Bank
EXPO_PUBLIC_BANK_ACCOUNT_NAME=Testimonies of Praise
EXPO_PUBLIC_BANK_ACCOUNT_NUMBER=0000000000

# Onboarding (Welcome screen) background: an image OR a video. See docs/ONBOARDING_MEDIA.md.
# Leave the URL empty to use the branded purple/gold background.
# TYPE is optional ('image' | 'video'); it is guessed from the URL extension when empty.
EXPO_PUBLIC_ONBOARDING_MEDIA_TYPE=
EXPO_PUBLIC_ONBOARDING_MEDIA_URL=
# Optional still image for videos: shown while loading, on metered data, with reduce-motion, or on failure
EXPO_PUBLIC_ONBOARDING_POSTER_URL=
# Optional 0..1 darkness of the text-readability overlay (default 0.55)
EXPO_PUBLIC_ONBOARDING_OVERLAY=

# Email verification (6-digit codes) service: the Cloudflare Worker in top-admin/worker
EXPO_PUBLIC_AUTH_API_URL=https://top-push-relay.gtrusouth116.workers.dev
