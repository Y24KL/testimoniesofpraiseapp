# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Use the SAME project as the mobile app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Free launch mode (all optional) ----
# Cloudinary (free, no card): lets admins upload videos/images from the portal.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Push relay (Cloudflare Worker, free): address of your deployed worker.
VITE_PUSH_URL=
