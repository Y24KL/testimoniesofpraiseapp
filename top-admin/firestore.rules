rules_version = '2';

// Data model shared by the mobile app and the admin portal.
// Admins are users that have a document at admins/{their uid} (create it by hand in the Firebase console).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A user may check whether THEY are an admin. Nobody can write here from a client.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Testimonies: the app only sees published ones; admins see and manage everything.
    match /testimonies/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.isPublished == true || resource.data.published == true));
      allow write: if isAdmin();
    }

    // Onboarding media shown on the Welcome screen BEFORE sign-in (public, non-sensitive):
    // { mediaType: 'image'|'video', mediaUrl, posterUrl, overlayOpacity }
    match /settings/onboarding {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live stream settings (a single document).
    match /settings/live {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =====================================================================
    // 1. ADOTOPOC RESOURCE CENTER
    // =====================================================================
    match /settings/adotopoc {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adotopocResources/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.published == true || resource.data.status == 'published'));
      allow write: if isAdmin();
    }

    // =====================================================================
    // 2. PROMOTIONALS SECTION
    // =====================================================================
    match /promotions/{id} {
      // Allow anyone to read published promos; admins manage everything
      allow read: if isAdmin() || resource.data.isPublished == true || resource.data.published == true || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    // =====================================================================
    // 3. WRITE-UPS & ARTICLES
    // =====================================================================
    match /articles/{id} {
      // Allow anyone to read published articles; admins manage everything
      allow read: if isAdmin() || resource.data.isPublished == true || resource.data.published == true || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    // In-app notification feed + announcement triggers.
    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.published == true || resource.data.status == 'published' || resource.data.isPublished == true));
      allow write: if isAdmin();
    }

    // =====================================================================
    // USER PROFILES: users/{uid}, one document per account (keyed by the Firebase UID).
    // The owner can create it once and complete a pending profile once; nobody can change another
    // user's profile, delete it, or write any other field. Admins can read for support.
    // =====================================================================
    function profileTitleOk(t) {
      return t in ['Mr', 'Mrs', 'Ms', 'Bro', 'Sis', 'Deacon', 'Deaconess', 'Pastor', 'Evangelist'];
    }
    function validProfileValues(d) {
      return profileTitleOk(d.title)
        && d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 120
        && d.zone is string && d.zone.size() > 0 && d.zone.size() <= 120
        && d.church is string && d.church.size() > 0 && d.church.size() <= 160;
    }
    // Video moment clips: written only by the scheduled indexer (admin SDK, which bypasses rules).
    // The app can read clips of published testimonies, and cannot write any.
    match /testimonyClips/{clipId} {
      allow read: if isAdmin() || (signedIn() && resource.data.isPublished == true);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // Either waiting for the profile form (e.g. first Google sign-in), or saved complete at sign-up.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['profileStatus', 'createdAt', 'title', 'fullName', 'zone', 'church', 'profileCompletedAt', 'updatedAt'])
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.profileStatus == 'pending' && !('title' in request.resource.data))
          || (request.resource.data.profileStatus == 'complete'
              && validProfileValues(request.resource.data)
              && request.resource.data.profileCompletedAt == request.time));

      // The welcome tour status, saved on the account so it follows the user to other devices.
      // Only tourStatus/tourUpdatedAt may change, and only to 'completed' or 'skipped'.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tourStatus', 'tourUpdatedAt'])
        && request.resource.data.tourStatus in ['completed', 'skipped']
        && request.resource.data.tourUpdatedAt == request.time;

      // Completing a pending profile, once, with validated values.
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.profileStatus == 'pending'
        && request.resource.data.profileStatus == 'complete'
        && request.resource.data.keys().hasOnly(['profileStatus', 'createdAt', 'title', 'fullName', 'zone', 'church', 'profileCompletedAt', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.profileCompletedAt == request.time
        && validProfileValues(request.resource.data);

      allow delete: if false;
    }

    // Per-user notification state (e.g., read/unread tracking).
    match /users/{uid}/notifications/{id} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, delete: if isAdmin();
      allow update: if signedIn() 
        && request.auth.uid == uid 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
    }

    // =====================================================================
    // 4. TOP RADIO & AUDIO TESTIMONIES
    // =====================================================================
    // TOP Radio stream configuration (stream URL, programme title, live status).
    match /settings/radio {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audio testimonies library.
    match /audioTestimonies/{id} {
      // Allow anyone to listen to published audio
      allow read: if isAdmin() || resource.data.isPublished == true || resource.data.published == true || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    // TOP Radio listener presence (matches existing liveViewers subcollection pattern).
    match /radioListeners/{sessionId} {
      allow read, delete: if isAdmin();
    }
    match /radioListeners/{sessionId}/listeners/{uid} {
      allow read: if isAdmin();
      allow write, delete: if signedIn() && request.auth.uid == uid;
    }

    // Direct radio session heartbeats & analytics.
    match /radioSessions/{sessionId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastHeartbeat', 'status', 'endTime']);
    }

    // =====================================================================
    // EXISTING APP COLLECTIONS
    // =====================================================================
    // Testimonies shared from the app. Users can create their own; only admins can read/manage them.
    match /testimonySubmissions/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fullName','churchZone','testimony','userId','userEmail','source','status','createdAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() < 200
        && request.resource.data.churchZone is string && request.resource.data.churchZone.size() < 200
        && request.resource.data.testimony is string && request.resource.data.testimony.size() > 0 && request.resource.data.testimony.size() < 5001
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Push tokens: a user manages only their own tokens.
    match /pushTokens/{token} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow read: if isAdmin();
    }

    // Analytics: apps write; admins read AND delete (the "reset everything" tool needs this).
    match /analyticsEvents/{id} {
      allow create: if signedIn();
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Live viewer presence: a heartbeat doc per person currently on the Live screen while a
    // stream is live (see src/hooks/useLiveViewer.ts in the mobile app). A user can only write
    // their own doc; admins read the whole set to show a live viewer count, and can clean it up
    // on reset.
    match /liveViewers/{sessionId} {
      allow read, delete: if isAdmin();
    }
    match /liveViewers/{sessionId}/viewers/{uid} {
      allow read: if isAdmin();
      allow write, delete: if signedIn() && request.auth.uid == uid;
    }

    // Live chat: scoped per stream session. Anyone signed in can read/post as themselves;
    // messages can't be edited once sent; only admins can delete (moderation).
    match /liveChat/{sessionId} {
      allow read, delete: if isAdmin(); // the rare "parent" doc itself, if one ever exists
    }
    match /liveChat/{sessionId}/messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() < 60
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Reports on chat messages: anyone can file one, only admins can read/manage them.
    match /liveChatReports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Bank-transfer sponsorships: a user can create and read their own; only admins can change status.
    match /sponsorships/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.receiptUrl is string && request.resource.data.receiptUrl.size() > 0;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================================
    // COMMENTS on video testimonies (testimonies/{id}/comments) and audio
    // testimonies (audioTestimonies/{id}/comments).
    //  - Document id == the commenter's Firebase UID: one comment per account
    //    per item, enforced by the database (a second device edits it).
    //  - Only signed-in users; the uid/media fields can never be changed or
    //    spoofed; text 1..1000 chars; server timestamps only.
    //  - Rate limit: every create/edit must be written in the same batch as
    //    commentRate/{uid}, which only accepts one write per 15 seconds.
    //  - Moderation: only admins change `status` (visible|hidden) or delete
    //    other people's comments. Hidden comments are visible to admins and
    //    to their author only.
    // =====================================================================
    function isPublishedDoc(path) {
      let d = get(path).data;
      return d.get('isPublished', false) == true || d.get('published', false) == true || d.get('status', '') == 'published';
    }
    function validCommentText(t) {
      return t is string && t.size() <= 1000 && t.trim().size() > 0;
    }
    function rateStamped(uid) {
      return getAfter(/databases/$(database)/documents/commentRate/$(uid)).data.lastAt == request.time;
    }
    function validNewComment(uid, mediaType, mediaId) {
      let c = request.resource.data;
      return c.keys().hasOnly(['uid', 'displayName', 'text', 'mediaType', 'mediaId', 'mediaTitle', 'status', 'createdAt', 'updatedAt'])
        && c.keys().hasAll(['uid', 'displayName', 'text', 'mediaType', 'mediaId', 'status', 'createdAt', 'updatedAt'])
        && c.uid == request.auth.uid && uid == request.auth.uid
        && c.mediaType == mediaType && c.mediaId == mediaId
        && c.displayName is string && c.displayName.size() > 0 && c.displayName.size() <= 60
        && (!('mediaTitle' in c) || (c.mediaTitle is string && c.mediaTitle.size() <= 200))
        && validCommentText(c.text)
        && c.status == 'visible'
        && c.createdAt == request.time && c.updatedAt == request.time;
    }
    function validOwnEdit(uid) {
      let c = request.resource.data;
      return resource.data.uid == request.auth.uid && uid == request.auth.uid
        && c.diff(resource.data).affectedKeys().hasOnly(['text', 'displayName', 'updatedAt'])
        && validCommentText(c.text)
        && c.displayName is string && c.displayName.size() > 0 && c.displayName.size() <= 60
        && c.updatedAt == request.time;
    }
    function validModeration() {
      let c = request.resource.data;
      return isAdmin()
        && c.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedAt', 'moderatedBy'])
        && c.status in ['visible', 'hidden']
        && c.moderatedBy == request.auth.uid && c.moderatedAt == request.time;
    }
    function canReadComment(parentPath) {
      return isAdmin() || (signedIn() && isPublishedDoc(parentPath)
        && (resource.data.status == 'visible' || resource.data.uid == request.auth.uid));
    }

    match /testimonies/{mediaId}/comments/{uid} {
      allow read: if canReadComment(/databases/$(database)/documents/testimonies/$(mediaId));
      allow create: if signedIn() && validNewComment(uid, 'video', mediaId) && rateStamped(uid)
        && isPublishedDoc(/databases/$(database)/documents/testimonies/$(mediaId));
      allow update: if (signedIn() && validOwnEdit(uid) && rateStamped(uid)) || validModeration();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /audioTestimonies/{mediaId}/comments/{uid} {
      allow read: if canReadComment(/databases/$(database)/documents/audioTestimonies/$(mediaId));
      allow create: if signedIn() && validNewComment(uid, 'audio', mediaId) && rateStamped(uid)
        && isPublishedDoc(/databases/$(database)/documents/audioTestimonies/$(mediaId));
      allow update: if (signedIn() && validOwnEdit(uid) && rateStamped(uid)) || validModeration();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // WRITTEN TESTIMONIES (text testimonies shown in the app's library). Admins write them, usually
    // from an approved testimony submission; signed-in users read the published ones.
    function validWrittenTestimony() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.body is string && d.body.size() > 0 && d.body.size() <= 20000
        && d.isPublished is bool
        && (!('authorName' in d) || (d.authorName is string && d.authorName.size() <= 120))
        && (!('churchZone' in d) || (d.churchZone is string && d.churchZone.size() <= 160))
        && (!('category' in d) || (d.category is string && d.category.size() <= 60))
        && (!('authorPhotoUrl' in d) || (d.authorPhotoUrl is string && d.authorPhotoUrl.size() <= 1000));
    }

    match /writtenTestimonies/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.isPublished == true);
      allow create, update: if isAdmin() && validWrittenTestimony();
      allow delete: if isAdmin();
    }

    match /writtenTestimonies/{mediaId}/comments/{uid} {
      allow read: if canReadComment(/databases/$(database)/documents/writtenTestimonies/$(mediaId));
      allow create: if signedIn() && validNewComment(uid, 'written', mediaId) && rateStamped(uid)
        && isPublishedDoc(/databases/$(database)/documents/writtenTestimonies/$(mediaId));
      allow update: if (signedIn() && validOwnEdit(uid) && rateStamped(uid)) || validModeration();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Admin dashboard: one collection-group query across every comments collection.
    match /{path=**}/comments/{commentId} {
      allow read: if isAdmin();
    }

    // Per-user comment rate limit stamp (see above). Only the user, only "now", at most every 15 s.
    match /commentRate/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt']) && request.resource.data.lastAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt']) && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(15, 's');
      allow delete: if false;
    }

  }
}
