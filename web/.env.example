# Firebase Web Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (Images & Receipts)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_RECEIPTS_PRESET=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Bunny Storage CDN (Optional custom pull zone hostname)
VITE_BUNNY_CDN_HOSTNAME=media.testimoniesofpraise.org

# Bank Details (Sponsor Screen)
VITE_BANK_NAME=Parallex Bank
VITE_BANK_ACCOUNT_NAME=Testimonies of Praise
VITE_BANK_ACCOUNT_NUMBER=1000316330

# Public Website URL
VITE_WEBSITE_URL=https://testimoniesofpraiseweb.onrender.com

# Onboarding (Welcome page) background: an image OR a video. See docs/ONBOARDING_MEDIA.md.
# Leave the URL empty for the branded purple/gold background. TYPE is optional ('image' | 'video').
VITE_ONBOARDING_MEDIA_TYPE=
VITE_ONBOARDING_MEDIA_URL=
# Optional poster for videos (loading, reduce-motion, data saver, failure)
VITE_ONBOARDING_POSTER_URL=
# Optional 0..1 darkness of the readability overlay (default 0.55)
VITE_ONBOARDING_OVERLAY=
