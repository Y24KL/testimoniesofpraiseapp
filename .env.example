# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app: never put secrets here.

# 'firestore' (default) or 'rest'
EXPO_PUBLIC_BACKEND_MODE=firestore

# Firebase web config (Firebase console > Project settings > Your apps > Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAg_3WiDv4LL2BWceIxcyx-GqXuef8VlD4
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=testimoniesofpraiseapp.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=testimoniesofpraiseapp
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=testimoniesofpraiseapp.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=754997860722
EXPO_PUBLIC_FIREBASE_APP_ID=1:754997860722:web:acff003464bb7aec7265eb

# Firestore collection / document names: change to match the EXISTING website backend
EXPO_PUBLIC_COL_TESTIMONIES=testimonies
EXPO_PUBLIC_COL_RESOURCES=resources
EXPO_PUBLIC_COL_NOTIFICATIONS=notifications
EXPO_PUBLIC_COL_SUBMISSIONS=testimonySubmissions
EXPO_PUBLIC_COL_PUSH_TOKENS=pushTokens
EXPO_PUBLIC_COL_ANALYTICS=analyticsEvents
EXPO_PUBLIC_DOC_LIVE=settings/live

# REST mode only (existing Node/Express API)
EXPO_PUBLIC_API_BASE_URL=https://testimoniesofpraiseweb.onrender.com

# Google OAuth client IDs (Google Cloud console > Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Public website used in share messages
EXPO_PUBLIC_WEBSITE_URL=https://testimoniesofpraiseweb.onrender.com

# Read by app.config.ts at build time
EAS_PROJECT_ID=
IOS_BUNDLE_ID=com.testimoniesofpraise.app
ANDROID_PACKAGE=com.testimoniesofpraise.app
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist
