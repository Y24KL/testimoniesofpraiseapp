rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Uploaded thumbnails and videos. Only admins can upload or delete.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && (request.resource == null || request.resource.size < 3 * 1024 * 1024 * 1024);
    }
  }
}
